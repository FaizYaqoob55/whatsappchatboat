# ─────────────────────────────────────────
#  WhatsApp Chatbot — Environment Variables
#  Copy this file to .env and fill in real values
# ─────────────────────────────────────────

# Meta / WhatsApp Cloud API
# Get from: https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string_here

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Business Info (AI system prompt mein use hoga)
BUSINESS_NAME=My Online Store
BUSINESS_DESCRIPTION=We sell quality products online in Pakistan
