# ─────────────────────────────────────────
#  WhatsApp Chatbot — Environment Variables
# ─────────────────────────────────────────

# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=mera_secret_verify_token_123

# OpenAI
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-3.5-turbo

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Business Info (AI system prompt mein use hoga)
BUSINESS_NAME=My Online Store
BUSINESS_DESCRIPTION=We sell quality products online in Pakistan
